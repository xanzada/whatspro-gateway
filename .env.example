PORT=3000
REDIS_URL=redis://default:password@redis-host:6379

# UI auth for /whatspro
WHATSPRO_USER=admin
WHATSPRO_PASSWORD=change-me
WHATSPRO_SESSION_SECRET=change-this-session-secret

# Machine-to-machine auth
WHATSPRO_API_TOKEN=change-this-bridge-token

# Incoming customer messages are forwarded here.
# Usually: https://chatwoot-adapter.example.com/webhooks/whatspro
# Or directly to the AI gateway: https://bot.example.com/webhook
INBOUND_WEBHOOK_URL=https://chatwoot-adapter.example.com/webhooks/whatspro
INBOUND_WEBHOOK_TOKEN=change-this-bridge-token

WHATSAPP_AUTH_PATH=/app/whatsapp_auth
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=true
