PORT=3000
REDIS_URL=redis://default:password@redis-host:6379

# UI auth for /whatspro
WHATSPRO_USER=admin
WHATSPRO_PASSWORD=change-me
WHATSPRO_SESSION_SECRET=change-this-session-secret

# Machine-to-machine auth
WHATSPRO_API_TOKEN=change-this-bridge-token

# Incoming customer messages are saved in Redis and optionally forwarded to OpenBot.
OPENBOT_WEBHOOK_URL=https://openbot-agent.example.com/webhook/whatsapp
OPENBOT_WEBHOOK_TOKEN=change-this-openbot-token
OPENBOT_WEBHOOK_TIMEOUT_MS=8000

WHATSAPP_AUTH_PATH=/app/whatsapp_auth
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=true
