PORT=3000

# Shared Redis. Dokploy: keep WhatsPro and Openbot on the same network.
REDIS_URL=redis://redis:6379

# UI/API security
WHATSPRO_API_TOKEN=
WHATSPRO_USER=admin
WHATSPRO_PASSWORD=change-me
WHATSPRO_SESSION_SECRET=change-me

# Openbot inbound webhook
OPENBOT_WEBHOOK_URL=http://openbot-fastfood:4100/webhook/whatsapp
OPENBOT_WEBHOOK_TOKEN=
OPENBOT_WEBHOOK_TIMEOUT_MS=8000

# WhatsApp session restore and Chromium runtime
WHATSAPP_AUTH_PATH=/app/whatsapp_auth
WHATSAPP_RESTORE_TIMEOUT_MS=120000
WHATSAPP_STATE_TIMEOUT_MS=2500
WHATSAPP_INITIALIZE_MAX_RETRIES=1
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# AI-human handoff. WhatsPro writes operator_active:{instanceId}:{phone}; Openbot reads it.
OPERATOR_ACTIVE_SECONDS=60

# Tenant config lookup for /chat.html?instance=...
NOCODB_URL=
NOCODB_TOKEN=
NOCODB_RESTAURANTS_TABLE_ID=
NOCODB_TABLE_ID=
NOCODB_TIMEOUT_MS=8000
NOCODB_CONFIG_CACHE_MS=300000
CHAT_PUBLIC_API_BASE=
